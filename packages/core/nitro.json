{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["ffmpeg"],
  "ios": {
    "iosModuleName": "NitroFFmpeg"
  },
  "android": {
    "androidNamespace": ["ffmpeg"],
    "androidCxxLibName": "NitroFFmpeg"
  },
  "autolinking": {
    "FFmpeg": {
      "swift": "HybridFFmpeg",
      "kotlin": "HybridFFmpeg"
    }
  },
  "ignorePaths": ["node_modules", "lib", "example"]
}
